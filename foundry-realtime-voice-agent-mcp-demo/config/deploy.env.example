# Copy this file to config/deploy.env and replace the Foundry project placeholders.
# Copy agent.example.json to agent.json and configure your own MCP endpoint there.
# See 02_build_and_deploy_voice_agent.md.

AZURE_VOICE_AGENTS_ENDPOINT="https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project-name>"
AZURE_AI_PROJECT_ID="/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<foundry-resource>/projects/<project-name>"

# Optional telephone bridge inputs. Use only a number and ACS resource you own.
# Both values are required by telephony_bridge/deploy.py --deploy.
# ACS_PHONE_NUMBER="<your-owned-E.164-number>"
# ACS_IMMUTABLE_ID="<your-acs-immutable-resource-id>"
